              "argumentsText": "{\"command\":\"python3 - <<'PY'\\nimport csv,json\\nfrom pathlib import Path\\nrows=list(csv.DictReader(Path('batch1.csv').open(newline='')))\\nlatest={r['id']:r for r in rows}\\ntotals={}; ids=[]\\nfor key,r in latest.items():\\n    if r['status'] not in ('posted','disputed'): continue\\n    amount=r['amount']; sign=-1 if amount.startswith('-') else 1\\n    whole,frac=amount.lstrip('+-').split('.')\\n    assert len(frac)==2\\n    cents=sign*(int(whole)*100+int(frac))\\n    totals[r['currency']]=totals.get(r['currency'],0)+cents\\n    ids.append(key)\\ndef fmt(n):\\n    return ('-' if n<0 else '')+str(abs(n)//100)+'.'+str(abs(n)%100).zfill(2)\\nresult={'policy':'v1','totals':{k:fmt(v) for k,v in sorted(totals.items())},'includedIds':sorted(ids)}\\nPath('close1.json').write_text(json.dumps(result,indent=2)+'\\\\n')\\nprint(json.dumps(result,indent=2))\\nPY\",\"verificationInputs\":null,\"verification\":null,\"timeoutMs\":null}"
