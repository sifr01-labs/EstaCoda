  "preliminaryLiveFindings": [
    {
      "issue": "Model retyped an accepted report, changing its bytes.",
      "fix": "Session-authorized exact copying through existing file.write sourceResult."
    },
    {
      "issue": "Empty optional content alongside sourceResult was rejected and classified as an uncertain mutation.",
      "fix": "Normalize empty/null placeholders; mark only proven pre-write validation failures as undispatched."
    },
    {
      "issue": "A literal 24-citation cap rejected observed sources; shared notes could duplicate sources.",
      "fix": "Retain size bounds and provenance checks, remove fixed citation count, merge shared source notes."
    },
    {
      "issue": "Balanced parentheses in publication URLs were stripped and valid citations appeared unobserved.",
      "fix": "Preserve balanced URL parentheses while removing Markdown closing delimiters."
    },
    {
      "issue": "All five preliminary runs completed three workers and synthesis but failed report delivery; large full-file ranges had no verification checksum.",
      "fix": "Hash all materialized bytes for a full file range, independently of bounded model preview."
    },
    {
      "issue": "Three subsequent live runs reached review because failed DDGS reads remained fatal despite other successful evidence.",
      "fix": "Permit same-provider observed evidence to recover provider read failures; add positive, no-evidence, unavailable-capability and denied-read tests."
    },
    {
      "issue": "A held-out run hit ENOTFOUND for a cited source; URL safety collapsed DNS failure into unsafe-url, so alternative observed evidence could not recover it.",
      "fix": "Distinguish unresolved from unsafe while keeping both unfetchable. Website-policy denial takes precedence over unresolved status. Optional unresolved sources can use other evidence; unobserved citations still fail."
    },
    {
      "issue": "The adjacent page-fetch error paths also classified ordinary transport failures as fatal to otherwise grounded research.",
      "fix": "Allow optional fetch/provider read failures to use other evidence; explicit source requirements, denied reads and unobserved citations remain blocking. Covered by targeted source tests and a final packaged extraction-failure scenario."
    }
  ],
  "governanceReview": [
    "Result copying reuses TaskResultService session/profile and content-integrity checks and requires task.result.read within current child authority.",
    "Normal workspace trust, approval, overwrite, shrink and materialization rules still apply.",
    "Only executor-owned no-effect file.write validation failures may be recovered by a later authorized same-path write.",
    "Denials, uncertain effects, partial file reads, unmatched hashes and unobserved citations remain blocking.",
    "Retry, scheduler and UI share cumulative limits; resume never resets them.",
    "DNS failure still prevents network dispatch. Invalid/private/metadata destinations and explicit website-policy denials retain their original refusal behavior; no safety failure is recategorized as a successful observation."
  ],
  "limitations": [
    "Provenance acceptance establishes observed citations and worker coverage, not scientific correctness.",
    "Live harnesses use isolated CLI-originated sessions with actual configured model/search services; packaged tests separately exercise app/gateway and once-only conversation delivery with synthetic providers.",
    "Installed user app and gateway have not been updated by this change."
  ],
