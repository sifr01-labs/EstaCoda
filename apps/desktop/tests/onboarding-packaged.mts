  if(auth==='api_key'){await page.getByRole('button',{name:t('Enter API key privately'),exact:true}).click();let credential:Page|undefined;await expect.poll(()=>{credential=browser!.contexts().flatMap(c=>c.pages()).find(p=>p.url().startsWith('estacoda://credential/'));return !!credential;},{timeout:10000}).toBe(true);await credential!.locator('#secret').fill('synthetic-onboarding-key');await credential!.locator('form button[type=submit]').click();await expect(page.getByText(t('Authorized. Save to finish setup.'),{exact:true})).toBeVisible();expect(await page.content()).not.toContain('synthetic-onboarding-key');}else await page.getByRole('button',{name:t('Continue without a credential'),exact:true}).click();
  await page.getByRole('button',{name:t('Use this model'),exact:true}).click();await expect(page.getByRole('dialog')).toHaveCount(0);expect(JSON.parse(readFileSync(join(profile,'config.json'),'utf8'))).toEqual(DEFAULT_PROFILE_CONFIG);expect(readFileSync(join(profile,'.env'),'utf8')).toBe('');
  console.log('Private route staged: '+language);await page.getByRole('button',{name:t('Continue'),exact:true}).click();await page.getByRole('button',{name:t('Choose folder'),exact:true}).click();
