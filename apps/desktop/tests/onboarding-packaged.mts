  await expect(page.getByText(workspace,{exact:true}).or(page.getByText(realpathSync(workspace),{exact:true}))).toBeVisible({timeout:15000});await page.getByRole('checkbox',{name:new RegExp(t('Allow work in this folder'))}).check();await page.getByRole('button',{name:t('Continue'),exact:true}).click();
  await expect(page.getByRole('button',{name:t('Finish setup'),exact:true})).toBeEnabled();await page.screenshot({path:join(output,`summary-${language}.png`)});await page.getByRole('button',{name:t('Finish setup'),exact:true}).click();await expect(page.getByRole('button',{name:t('Open EstaCoda'),exact:true})).toBeEnabled({timeout:30000});await page.screenshot({path:join(output,`ready-${language}.png`)});await page.getByRole('button',{name:t('Open EstaCoda'),exact:true}).click();await expect(page.locator('#ec-sidebar')).toBeVisible();
  console.log('Setup saved and verified: '+language);await page.getByRole('textbox',{name:t('Draft guidance'),exact:true}).fill('Reply with the exact text "ONBOARDING_WORK_COMPLETE". Do not use tools or change files.');await page.getByRole('button',{name:t('Send prompt'),exact:true}).click();await expect(page.getByText('ONBOARDING_WORK_COMPLETE',{exact:true}).first()).toBeVisible({timeout:60000});await expect.poll(()=>page.evaluate(async()=>(await window.desktop.snapshot()).work.items.find(w=>w.kind==='session')?.status),{timeout:30000}).toBe('completed');await page.screenshot({path:join(output,`first-work-${language}.png`)});expect(requests).toBeGreaterThan(0);const config=readFileSync(join(profile,'config.json'),'utf8'),workId=(await page.evaluate(async()=>{const s=await window.desktop.snapshot();return s.work.items.find(w=>w.kind==='session')?.id;}));expect(workId).toBeTruthy();expect(readFileSync(join(home,'.estacoda/active-profile.json'),'utf8')).toBe(activeProfile);
  expect(await stopApp()).toBe(true);page=await launch();expect(readFileSync(join(profile,'config.json'),'utf8')).toBe(config);await expect.poll(()=>page.evaluate(async()=>{const s=await window.desktop.snapshot();return s.work.items.map(w=>w.id);}),{timeout:30000}).toContain(workId);await expect(page.locator('html')).toHaveAttribute('lang',language);records.push({language,auth,packaged:true,signature:'ad-hoc verified',isolatedFreshProfile:true,pathWithoutNodeOrCli:true,realRuntimeWork:true,provider:'scripted loopback HTTP',restartPreserved:true,completed:true,requests});console.log('Packaged first Work and restart passed: '+language);
 }catch(error){writeFileSync(join(output,`app-errors-${language}.txt`),appErrors.slice(-24000));if(browser){const page=browser.contexts().flatMap(c=>c.pages()).find(p=>p.url().startsWith('estacoda://app/'));if(page){await page.screenshot({path:join(output,`failure-${language}.png`)});writeFileSync(join(output,`failure-${language}.txt`),(await page.locator('body').innerText()).slice(0,12000));}}throw error;}
 finally{await stopApp();provider.closeAllConnections();await new Promise<void>(r=>provider.close(()=>r()));try{const lock=JSON.parse(readFileSync(join(profile,'gateway/gateway.lock'),'utf8'));const cmd=execFileSync('ps',['-p',String(lock.pid),'-o','command='],{encoding:'utf8'});if(cmd.includes(staging)&&cmd.includes('gateway')){process.kill(lock.pid,'SIGTERM');await expect.poll(()=>{try{process.kill(lock.pid,0);return false;}catch{return true;}},{timeout:10000}).toBe(true);}}catch{}rmSync(home,{recursive:true,force:true,maxRetries:10,retryDelay:200});}
}
writeFileSync(join(output,'packaged-results.json'),JSON.stringify(records,null,2));if(!process.argv[3])rmSync(staging,{recursive:true,force:true});
