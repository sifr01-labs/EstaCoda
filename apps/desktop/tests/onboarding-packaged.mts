  await page.getByRole('combobox',{name:'Display language',exact:true}).selectOption(language);await expect(page.locator('html')).toHaveAttribute('lang',language);
  await expect(page.locator('.ec-window')).toHaveAttribute('data-onboarding','true');await expect(page.locator('#ec-sidebar')).toBeHidden();await expect(page.locator('.ec-runtimebar')).toBeHidden();await page.screenshot({path:join(output,`welcome-${language}.png`)});
