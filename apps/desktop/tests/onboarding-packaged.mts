 const home=mkdtempSync('/tmp/ec-first-work '+language+'-'),workspace=home;const profileId='test-'+randomBytes(4).toString('hex'),profile=join(home,'.estacoda/profiles',profileId),activeProfile=JSON.stringify({profileId}),auth=language==='en'?'api_key':'none';let appErrors='',requests=0,child:ChildProcess|undefined,browser:Browser|undefined;
 const provider=createServer(async(req,res)=>{let raw='';for await(const data of req){raw+=data;if(raw.length>4_194_304){res.writeHead(413).end();return;}}if(++requests>24){res.writeHead(429).end();return;}const input=JSON.parse(raw);if(auth==='api_key')expect(req.headers.authorization).toMatch(/^Bearer synthetic-onboarding/);else expect(req.headers.authorization).toBeUndefined();const text='ONBOARDING_WORK_COMPLETE';res.writeHead(200,{'content-type':input.stream?'text/event-stream':'application/json'});const choice={index:0,...(input.stream?{delta:{content:text}}:{message:{role:'assistant',content:text}}),finish_reason:'stop'};const result={id:'fixture',object:'chat.completion',choices:[choice],usage:{prompt_tokens:30,completion_tokens:8,total_tokens:38}};res.end(input.stream?'data: '+JSON.stringify(result)+'\n\ndata: [DONE]\n\n':JSON.stringify(result));});await new Promise<void>(r=>provider.listen(0,'127.0.0.1',r));const endpoint=`http://127.0.0.1:${(provider.address() as {port:number}).port}/v1`;
